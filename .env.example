# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env.local and fill with your actual credentials.
# WARNING: NEVER commit .env.local or production secrets to Git!
# ==============================================================================

# 1. Supabase Client Configuration (Public & User-Scoped with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# 2. Supabase Trusted Server Configuration (Least-Privilege: Server-side only)
# Used exclusively by trusted administrative server routes (bypasses RLS).
# NEVER expose this key in client-side code, git, or public bundles!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. PhonePe Payment Gateway (Swiggy / Zomato UPI Intent & Multi-App PG)
# For UAT Sandbox Testing:
# PHONEPE_MERCHANT_ID=PGTESTPAYUAT
# PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
# PHONEPE_SALT_INDEX=1
# PHONEPE_ENV=UAT
#
# For Live Production:
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key_never_expose
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PROD

# 4. Razorpay Payment Gateway (Optional Fallback)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_never_expose
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_never_expose

# 5. Admin Authentication & Session Signing Secret (Strictly server-side)
ADMIN_EMAIL=owner@nexora.com
ADMIN_PASSWORD=your_secure_strong_admin_password_min_12_chars
ADMIN_SESSION_SECRET=nexora_production_admin_session_secret_32_bytes_min
